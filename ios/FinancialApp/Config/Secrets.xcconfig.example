// Copy to Secrets.xcconfig (gitignored) and fill with values from the web .env:
//   VITE_SUPABASE_URL  → SUPABASE_URL
//   VITE_SUPABASE_ANON_KEY → SUPABASE_ANON_KEY
// In xcconfig, "//" starts a comment — write https URLs as https:/$()/host...

SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = REPLACE_ME
API_BASE_URL = https:/$()/YOUR_PROJECT.supabase.co/functions/v1/pluggy-proxy

