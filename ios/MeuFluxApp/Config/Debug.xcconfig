// Debug defaults first, then Secrets overrides (include MUST be last).
// Em xcconfig, "//" começa comentário — URLs usam https:/$()/host

PRODUCT_BUNDLE_IDENTIFIER = com.meuflux.app.debug
PRODUCT_NAME = MeuFlux
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
APP_DISPLAY_NAME = MeuFlux
INFOPLIST_KEY_CFBundleDisplayName = MeuFlux

SUPABASE_URL = https:/$()/tslzhkbxabbhrmbefhrj.supabase.co
API_BASE_URL = https:/$()/tslzhkbxabbhrmbefhrj.supabase.co/functions/v1/pluggy-proxy
SUPABASE_ANON_KEY = REPLACE_ME

// Overrides REPLACE_ME when the file exists (generated by: npm run ios:secrets)
#include? "Secrets.xcconfig"
